# Open WebUI — Hugging Face Space variables and secrets.
#
# These go in Space → Settings → Variables and secrets (HF does not read a .env
# file). This file is documentation, not something the app loads; copy it into
# `deploy/<your-space>.env` (git-ignored) if you want to keep the list to hand.
#
# Kind  = the HF field to use: "Secret" hides the value, "Variable" does not.

# ── Security ──────────────────────────────────────────────────────────────────
# Signs session JWTs. Fixed value, not auto-generated, so logins survive
# restarts. Generate one with:  openssl rand -base64 32
WEBUI_SECRET_KEY=                       # Secret
# First-admin signup. start.sh registers this via /api/v1/auths/signup when the
# Space runtime provides SPACE_ID, so you don't have to race the public signup.
ADMIN_USER_EMAIL=                       # Secret
ADMIN_USER_PASSWORD=                    # Secret
# Close self-registration: a public .hf.space URL WILL be found by bots.
ENABLE_SIGNUP=false                     # Variable
ENABLE_INITIAL_ADMIN_SIGNUP=true        # Variable

# ── Model provider (OpenAI-compatible) ─────────────────────────────────────────
# Pick one; the rest of this file works either way.
OPENAI_API_KEY=                         # Secret
OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_BASE_URL=https://openrouter.ai/api/v1   # has free-tier models
# OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
# Ollama lives elsewhere (or nowhere) — turning it off skips a slow startup probe
# and removes the "no models" error banner.
ENABLE_OLLAMA_API=false                 # Variable
# OLLAMA_BASE_URL=https://ollama.com/<you>          # Variable, if you do have one

# ── Memory tuning (free cpu-basic is 2 vCPU / 16 GB) ─────────────────────────
# Leave the local embedding/reranker models unset unless you attached a Storage
# Bucket: they download into DATA_DIR (≈900 MB) on first start and are lost on
# every rebuild otherwise.
RAG_EMBEDDING_MODEL=                    # Variable (empty = use an API embedder)
RAG_RERANKING_MODEL=                    # Variable
# One worker per 2 vCPU; more workers multiply the resident set.
UVICORN_WORKERS=1                       # Variable

# ── Nice to have on a public Space ────────────────────────────────────────────
ENABLE_COMMUNITY_SHARING=false          # Variable, hides the openwebui.com tab
ENABLE_EVALUATION_A_REPLIES_MODEL=false # Variable
ENABLE_TELEMETRY=true                   # Variable, keeps "Sign in with HF"
# OAuth against Hugging Face itself (Space → Settings → Hugging Face OAuth):
# sets WEBUI_URL automatically from the Space host; leave commented until enabled.
# OAUTH_PROVIDERS=huggingface
# HF_OAUTH_CLIENT_ID=                   # Variable
# HF_OAUTH_CLIENT_SECRET=               # Secret
